DEBUG=true
# Required when DEBUG is false. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins allowed to call /graphql, e.g. http://localhost:3000
CORS_ALLOWED_ORIGINS=
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
GRAPHQL_MAX_DEPTH=5
# Defaults to the DEBUG value when unset.
# GRAPHQL_INTROSPECTION=false
# No AWS keys are needed for the Cognito calls this API makes; never commit credentials.
